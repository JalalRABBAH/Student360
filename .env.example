# ---------------------------------------------------------------------------
# STUDENT360 — environment configuration
# Copy to `.env` :  copy .env.example .env       (Windows)
#                   cp .env.example .env         (macOS / Linux)
# ---------------------------------------------------------------------------

# Database.
# Local development uses SQLite so the platform runs with zero external
# services. For production, switch `provider` in prisma/schema.prisma to
# "postgresql" and point DATABASE_URL at your Postgres / Supabase instance:
#   DATABASE_URL="postgresql://user:pass@host:5432/student360?schema=public"
DATABASE_URL="file:./dev.db"

# Session signing secret (min 32 chars). Rotate in production.
AUTH_SECRET="student360-development-secret-key-change-me-in-production"

# Session lifetime in seconds — 12h default.
AUTH_SESSION_MAX_AGE=43200

# Public app URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Default locale (en | fr | ar)
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# AI Copilot — the built-in copilot works fully offline using the deterministic
# on-platform reasoning engine. Optionally plug an LLM provider:
# COPILOT_PROVIDER="openai"
# OPENAI_API_KEY=""
COPILOT_PROVIDER="local"

# Seed / demo password for every demo account
DEMO_PASSWORD="Student360!"
